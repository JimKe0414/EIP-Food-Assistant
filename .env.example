WEB_PORT=3000
POSTGRES_DB=first_choice_food
POSTGRES_USER=food_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
SESSION_PASSWORD=replace-with-at-least-32-random-characters
IDENTITY_HMAC_SECRET=replace-with-a-separate-random-secret
INTERNAL_WORKER_TOKEN=replace-with-a-third-random-secret
AUTH_MODE=dev
GOOGLE_WORKSPACE_DOMAIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://localhost:3000/api/auth/google-callback
ALLOW_DEV_AUTH=true
APP_TIME_ZONE=Asia/Taipei
# Cookies default to Secure (HTTPS-only). Only set to false for local testing of the
# production build over plain http:// (e.g. `docker compose up` against localhost
# without TLS) — leave unset/true for any real deployment.
# COOKIE_SECURE=false

# AI provider selection
#
# AI_EGRESS_MODE controls whether network calls to a cloud AI are permitted:
# - local-only: allows local/stub providers only; the worker refuses to start with a cloud provider.
# - cloud-approved: permits cloud providers, but does not select one automatically.
#
# Provider purpose and supported values:
# - AI_TEXT_PROVIDER: text meal analysis, voice-transcript analysis, lunch recommendation,
#   and portion refinement. Values: stub, ollama, openai-compatible, google-genai.
# - AI_VISION_PROVIDER: photo meal analysis. Values: stub, ollama,
#   openai-compatible, google-genai.
# - AI_AUDIO_PROVIDER: speech-to-text only; the transcript is then analyzed by
#   AI_TEXT_PROVIDER. Values: stub, local-whisper, whisper-cpp,
#   openai-compatible, google-genai.
#
# IMPORTANT: stub is deterministic test data, not AI analysis. It always returns the same
# nutrients/portion (and a fixed transcript for audio) regardless of the input. Setting a
# model name below does not override a provider that is still set to stub.
# Recreate the worker container after changing any AI_* provider or model setting.
AI_EGRESS_MODE=local-only
AI_TEXT_PROVIDER=stub
AI_VISION_PROVIDER=stub
AI_AUDIO_PROVIDER=stub
AI_TEXT_MODEL=llama3.1:8b
AI_VISION_MODEL=llava:13b
OLLAMA_BASE_URL=http://ollama:11434
# AI_AUDIO_PROVIDER=local-whisper targets the bundled whisper/ FastAPI service (faster-whisper,
# GPU-only, started via `docker compose --profile local-audio up`) at WHISPER_BASE_URL, default
# http://whisper:8000 (the Docker service name).
# AI_AUDIO_PROVIDER=whisper-cpp targets a whisper.cpp `examples/server` instance instead — a
# different HTTP contract (POST /inference) than the faster-whisper service above. If you're
# running whisper.cpp's server.exe natively on your Windows host (not inside this compose
# project), point WHISPER_BASE_URL at the host from the worker container's perspective, e.g.
# WHISPER_BASE_URL=http://host.docker.internal:8080
WHISPER_BASE_URL=http://whisper:8000

# Cloud OpenAI-compatible endpoint (used with AI_TEXT_PROVIDER/AI_VISION_PROVIDER=openai-compatible
# and AI_EGRESS_MODE=cloud-approved). Company test environment serves two Qwen3.6-35B-A3B
# variants: "-fast" for general use, "-thinking" for complex tasks — the thinking variant
# needs OPENAI_COMPAT_MAX_TOKENS >= 4000 since it spends part of the budget on reasoning
# before the final answer. Prefer secrets/openai_compat_api_key.txt over this env var in
# any real deployment; see README.
OPENAI_COMPAT_BASE_URL=https://api.focusit.tw/openai/v1
OPENAI_COMPAT_API_KEY=replace-with-the-real-key
OPENAI_COMPAT_TEXT_MODEL=Qwen3.6-35B-A3B-fast
OPENAI_COMPAT_VISION_MODEL=Qwen3.6-35B-A3B-fast
OPENAI_COMPAT_MAX_TOKENS=4000

TFDA_AUTO_DOWNLOAD=false
TFDA_NUTRIENT_XLSX_URL=https://consumer.fda.gov.tw/uc/GetFile.ashx?type=ServerFile&id=4862259227103213368
